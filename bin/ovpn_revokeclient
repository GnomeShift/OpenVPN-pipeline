#!/bin/bash

#
# Revoke a client certificate
#

if [ "${DEBUG:-}" == "1" ]; then
  set -x
fi

set -e

if [ -z "${OPENVPN:-}" ]; then
  export OPENVPN="$PWD"
fi
if ! source "$OPENVPN/ovpn_env.sh"; then
  echo "Could not source $OPENVPN/ovpn_env.sh."
  exit 1
fi
if [ -z "${EASYRSA_PKI:-}" ]; then
  export EASYRSA_PKI="$OPENVPN/pki"
fi

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "usage: $0 CLIENT_CN" >&2
  exit 1
fi

cn="$1"

if [ ! -f "$EASYRSA_PKI/private/${cn}.key" ]; then
  echo "Unable to find \"${cn}\", please try again or generate the key first" >&2
  exit 1
fi

# easy-rsa 3.2.x: "revoke" is deprecated and only runs in batch mode
# so easy-rsa's own confirmation is bypassed
# Keep an explicit confirmation for interactive sessions instead
if [ -t 0 ]; then
  printf 'Revoke certificate "%s"? [y/N] ' "$cn"
  read -r answer || answer=""
  case "$answer" in
  y|Y|yes|YES) ;;
  *) echo "Aborted." >&2; exit 1 ;;
  esac
fi

revoke_client_certificate(){
  EASYRSA_BATCH=1 easyrsa revoke "$1"
  echo "Generating the Certificate Revocation List :"
  EASYRSA_BATCH=1 easyrsa gen-crl
  cp -f "$EASYRSA_PKI/crl.pem" "$OPENVPN/crl.pem"
  chmod 644 "$OPENVPN/crl.pem"
}

revoke_client_certificate "$cn"
echo "Done. Restart the container to apply the new CRL."
